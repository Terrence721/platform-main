# The Helpdesk's local settings. Copy this file to .env (git ignores .env)
# and change the values if you like; compose.yaml and the API read .env,
# and fall back to these same values when it is missing.
# Local development only: the database listens on 127.0.0.1 alone.

# PostgreSQL in Docker (compose.yaml)
HELPDESK_DB_NAME=helpdesk
HELPDESK_DB_USER=helpdesk
HELPDESK_DB_PASSWORD=helpdesk-dev-only
HELPDESK_DB_PORT=5435

# How the API connects to it (used from DB step 2, Drizzle)
DATABASE_URL=postgres://helpdesk:helpdesk-dev-only@localhost:5435/helpdesk

# The password every seeded user signs in with (yarn db:seed). Local
# development only: the seed data is recreated on every start.
HELPDESK_SEED_PASSWORD=helpdesk-dev-only

# Node environment. The Docker image sets production automatically; leave it
# unset for local development so cookies stay usable over HTTP.
# NODE_ENV=production

# Signs sign-in sessions (JWTs in an httpOnly cookie). `nx serve` uses a
# development secret when this is unset. The Docker image runs in production,
# where HELPDESK_JWT_SECRET must be set (32+ chars, not the published
# development one) - see docs/deployment.md.
# HELPDESK_JWT_SECRET=
