{
  "name": "helpdesk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/helpdesk/src",
  "prefix": "hd",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/projects/helpdesk",
        "index": "projects/helpdesk/src/index.html",
        "browser": "projects/helpdesk/src/main.ts",
        "tsConfig": "projects/helpdesk/tsconfig.app.json",
        "assets": [
          "projects/helpdesk/src/favicon.ico",
          {
            "glob": "**/*",
            "input": "projects/helpdesk/src/assets",
            "output": "assets"
          }
        ],
        "styles": [
          "@angular/material/prebuilt-themes/azure-blue.css",
          "projects/helpdesk/src/styles.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "575kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "projects/helpdesk/proxy.conf.mjs"
      },
      "configurations": {
        "production": {
          "buildTarget": "helpdesk:build:production"
        },
        "development": {
          "buildTarget": "helpdesk:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "outputs": ["{workspaceRoot}/coverage/projects/helpdesk"]
    },
    "lint": {
      "dependsOn": ["eslint-plugin:build"]
    }
  }
}
