{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "stripInternal": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "../../dist/modules/schematics-core",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "testing/**/*.ts", "test-setup.ts"]
}
