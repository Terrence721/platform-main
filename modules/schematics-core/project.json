{
  "name": "schematics-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "modules/schematics-core",
  "prefix": "ngrx",
  "tags": [],
  "generators": {},
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/modules/schematics-core"],
      "options": {
        "command": "tsc -p modules/schematics-core/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "modules/schematics-core/*/**/*.ts",
          "modules/schematics-core/*/**/*.html"
        ]
      },
      "outputs": ["{options.outputFile}"]
    }
  }
}
