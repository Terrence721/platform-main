{
  "name": "platform-main",
  "version": "0.0.0",
  "description": "Demonstration NgRx + Nx workspace, not affiliated with the upstream @ngrx/platform project",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:report": "vitest run",
    "test:report:view": "vite preview --outDir test-results",
    "test:summary": "npx tsx scripts/generate-test-summary.ts",
    "test:scripts": "vitest run --project scripts",
    "clean": "git clean -xdf",
    "clean:logs": "npx tsx scripts/clean-logs.ts",
    "check:versions": "npx tsx scripts/check-version-ranges.ts",
    "prettier": "prettier --write \"**/*.ts\"",
    "schematics:check": "git diff --name-only --exit-code ./modules",
    "nx": "nx",
    "update": "nx migrate latest",
    "update:check": "ng update",
    "lint": "nx run-many --target=lint --all",
    "spell": "cspell --no-progress --gitignore \"**/*\"",
    "eslint-plugin:update": "npx tsx modules/eslint-plugin/scripts/generate-config.ts",
    "postinstall": "husky"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "yarn": ">=4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "nx/brace-expansion": "^5.0.9",
    "compare-func/dot-prop": "^4.2.1",
    "xmlbuilder2/js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "braces": "^3.0.3",
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "nanoid": "^3.3.18",
    "decode-uri-component": "^0.5.0",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.7",
    "js-yaml": "^3.15.2",
    "smol-toml": "^1.7.1"
  },
  "lint-staged": {
    "*.{ts,json,md,html,code-workspace}": "prettier --write"
  },
  "keywords": [
    "ngrx",
    "angular",
    "rxjs"
  ],
  "author": "Terrence Daniels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terrence721/platform-main.git"
  },
  "dependencies": {
    "@analogjs/content": "2.7.5",
    "@analogjs/router": "2.7.5",
    "@angular/cdk": "22.2.0",
