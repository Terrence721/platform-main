{
  "name": "platform-main",
  "version": "0.0.0",
  "description": "Demonstration NgRx + Nx workspace, not affiliated with the upstream @ngrx/platform project",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "nx run-many --target=build --all",
    "deploy:builds": "npx tsx ./build/deploy-build.ts",
    "test": "nx run-many --target=test --all",
    "test:report": "vitest run",
    "test:report:view": "vite preview --outDir test-results",
    "test:summary": "npx tsx scripts/generate-test-summary.ts",
    "clean": "git clean -xdf",
    "clean:logs": "npx tsx scripts/clean-logs.ts",
    "coverage:html": "nyc report --reporter=html",
    "copy:dist": "ncp dist/ ./node_modules/@ngrx/",
    "ci": "yarn test && nyc report --reporter=text-lcov | coveralls",
    "prettier": "prettier --write \"**/*.ts\"",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "copy:schematics": "npx tsx ./build/copy-schematics-core.ts",
    "schematics:check": "git diff --name-only --exit-code ./modules",
    "build:stackblitz": "npx tsx ./build/stackblitz.ts && git add ./stackblitz.html",
    "publish:next": "npx tsx ./build/publish-rc.1",
    "publish:latest": "npx tsx ./build/publish-latest.ts",
    "nx": "nx",
    "update": "nx migrate latest",
    "update:check": "ng update",
    "update:versions": "npx tsx ./build/update-version-numbers.ts",
    "lint": "nx run-many --target=lint --all",
    "eslint-plugin:update": "npx tsx ./build/generate-eslint-plugin.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "yarn": "^1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "qs": "^6.15.3",
    "braces": "^3.0.3",
    "**/nx/brace-expansion": "^5.0.9",
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "**/compare-func/dot-prop": "^4.2.1",
    "nanoid": "^3.3.18",
    "decode-uri-component": "^0.5.0"
  },
  "lint-staged": {
    "*.{ts,json,md,html,code-workspace}": "prettier --write"
  },
  "keywords": [
    "ngrx",
    "angular",
    "rxjs"
  ],
  "author": "Terrence Daniels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terrence721/platform-main.git"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.spec",
      "**/spec/**/*",
      "/modules/schematics/src/*/files/**/*",
      "/modules/**/schematics/**/files/**/*",
      "**/schematics/src/utility/*"
    ],
    "include": [
      "**/*.ts"
    ]
  },
  "dependencies": {
    "@analogjs/content": "2.6.4",
    "@analogjs/router": "2.6.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/elements": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@microsoft/api-extractor": "^7.55.1",
    "@microsoft/tsdoc": "^0.16.0",
    "@nx/angular": "23.1.2",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.9.0",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "marked-mangle": "^1.1.12",
    "marked-shiki": "^1.2.1",
    "rxjs": "7.8.2",
    "semver": "^7.7.2",
    "shiki": "^1.29.2",
    "tslib": "^2.8.1",
    "tsx": "^4.11.2",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/platform": "2.6.4",
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/core": "22.1.6",
    "@angular-devkit/schematics": "22.1.6",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular-eslint/test-utils": "22.1.0",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@angular/language-service": "22.1.4",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.1.2",
    "@nx/eslint-plugin": "23.1.2",
    "@nx/node": "23.1.2",
    "@nx/playwright": "23.1.2",
    "@nx/vite": "23.1.2",
    "@nx/vitest": "23.1.2",
    "@nx/workspace": "23.1.2",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@schematics/angular": "22.1.3",
    "@stackblitz/sdk": "^1.11.0",
    "@types/ncp": "^2.0.8",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.7.0",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/rule-tester": "8.66.0",
    "@typescript-eslint/types": "8.66.0",
    "@typescript-eslint/utils": "8.66.0",
    "@vitest/ui": "4.1.10",
    "angular-eslint": "22.1.0",
    "conventional-changelog-cli": "^1.3.21",
    "cpy-cli": "^6.0.0",
    "deep-freeze": "^0.0.1",
    "eslint": "10.8.0",
    "express": "4.21.2",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.3.0",
    "mkdirp": "^3.0.1",
    "ncp": "^2.0.0",
    "ng-packagr": "22.1.1",
    "nx": "23.1.2",
    "ora": "^8.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.62.4",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rxjs-marbles": "^7.0.1",
    "tinyglobby": "^0.2.14",
    "ts-loader": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-snippet": "5.0.2",
    "tsconfig-paths": "^3.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.10",
    "yaml": "^2.4.5"
  }
}
