{
  "name": "schematics-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "modules/schematics-core",
  "prefix": "ngrx",
  "tags": [],
  "generators": {},
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/modules/schematics-core",
        "{workspaceRoot}/node_modules/@ngrx/schematics-core"
      ],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "tsc -p modules/schematics-core/tsconfig.lib.json"
          },
          {
            "command": "rimraf node_modules/@ngrx/schematics-core"
          },
          {
            "command": "mkdirp node_modules/@ngrx/schematics-core"
          },
          {
            "command": "ncp dist/modules/schematics-core node_modules/@ngrx/schematics-core"
          }
        ]
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/coverage/modules/schematics-core"]
    }
  }
}
