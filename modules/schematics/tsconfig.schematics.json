{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "..",
    "stripInternal": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    "ignoreDeprecations": "6.0",
    "outDir": "../../dist/modules",
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["migrations/**/*.ts", "ng-add/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
